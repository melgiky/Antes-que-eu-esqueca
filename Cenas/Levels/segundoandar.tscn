[sub_resource type="GDScript" id="GDScript_p47ww"]
script/source = "extends Node2D

@onready var player: CharacterBody2D = $Ysort/Player

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.
	iniciar_dialogo()
	Dialogic.timeline_ended.connect(_dialogo_terminou)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass



func _on_area_2d_body_shape_entered(body_rid: RID, body: Node2D, body_shape_index: int, local_shape_index: int) -> void:
	if body.is_in_group(\"player\"):
		$Ysort/Player.can_move = false
		Transitions.transition()
		await Transitions.on_transition_finished
		GameManager.completar_objetivo(\"descer_escada\")
		get_tree().change_scene_to_file(\"res://Cenas/Levels/primeiroandar.tscn\")
	
func iniciar_dialogo():
	# Impede o Antônio de andar durante o diálogo
	$Ysort/Player.can_move = false

	# Inicia a Timeline do Dialogic
	Dialogic.start(\"res://dialogic/segundoandar.dtl\")

func _dialogo_terminou():
	$Ysort/Player.can_move = true
"

